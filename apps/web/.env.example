# URL del backend (solo del lado del servidor de Next; el navegador usa /api/* del mismo origen).
BACKEND_URL=http://localhost:8000
# Producción (Vercel): el mismo valor que PROXY_SHARED_SECRET del backend. Con él, el proxy
# le pasa al backend la IP real del usuario para el rate limit. En desarrollo no hace falta.
# PROXY_SHARED_SECRET=
