{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && ENV=${CS_ENV:-development} .venv/bin/uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/web && npx next dev -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "backend-sin-jobs",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && ENV=test .venv/bin/uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    }
  ]
}