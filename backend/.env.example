# Copiar a backend/.env para desarrollo local.
ENV=development
LOG_LEVEL=INFO

# Rol de la aplicación (sin ownership, sujeto a RLS) y rol dueño para Alembic.
# Con `docker compose up -d db` (puerto 5432):
DATABASE_URL=postgresql+asyncpg://clubsystem_app:app@localhost:5432/clubsystem
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://clubsystem_owner:owner@localhost:5432/clubsystem
DB_APP_ROLE=clubsystem_app

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# En desarrollo sobre http://localhost las cookies no pueden ser Secure.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_WEB_URL=http://localhost:3000
EMAIL_BACKEND=console

# Detección de anomalías (opcional en desarrollo)
ANTHROPIC_API_KEY=
ANOMALY_MODEL=claude-opus-5-5
